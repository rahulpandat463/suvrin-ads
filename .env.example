# ==============================================================================
# SUVRIN ADS (INDIA & GURGAON) - ENVIRONMENT VARIABLES
# ==============================================================================

# Central Backend Lead Sync (Step 2 of Booking Chain)
# Point this to your central backend (e.g., https://suvrin.com or https://backend.suvrin.com)
MAIN_BACKEND_URL=https://suvrin.com

# Shared API secret key verified by POST /api/leads in the central backend
LEADS_SYNC_SECRET=your_leads_sync_secret_here

# Region identifier accepted by central backend ConsultationLead table (default: uae)
LEAD_REGION=uae

# Resend Email Notification (Direct fallback notification)
RESEND_API_KEY=re_your_api_key_here
TEAM_EMAIL=sudeep@suvrin.com

# Optional Webhook URL (e.g. Google Sheets, Zapier, Make, or CRM webhook)
BOOKING_WEBHOOK_URL=
